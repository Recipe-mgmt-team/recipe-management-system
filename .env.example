# Copy this file to .env and fill in your own keys. Never commit .env.

# USDA FoodData Central - free key: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=DEMO_KEY

# Google Gemini - free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: used automatically when the main model is overloaded
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Faster answers: minimal, low, medium or high (empty = model default)
GEMINI_THINKING=
GEMINI_TIMEOUT=90
